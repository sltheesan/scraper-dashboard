{
  "name": "scraper-app",
  "version": "0.1.0",
  "description": "Multi-profile browser scraper with web dashboard",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "login": "node scripts/login.js"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "scripts"
    ],
    "ignore": [
      "profiles/**",
      "node_modules/**",
      "src/public/**"
    ],
    "ext": "js,json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/static": "^7.0.4",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "mongoose": "^8.5.1",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pino-pretty": "^11.2.2"
  }
}
