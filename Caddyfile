# Caddy reverse-proxy + automatic HTTPS via Let's Encrypt.
# Lives on the VPS at /root/scraper-app/Caddyfile.

scraper.200m.tech {
  encode gzip

  # /vnc/* — noVNC web client + websockify endpoint.
  # forward_auth makes Caddy call /api/auth/me first; if the request lacks a
  # valid dashboard JWT cookie, it's rejected before reaching noVNC. So the
  # only way to view the VPS browser is to be signed in to the dashboard.
  handle_path /vnc/* {
    forward_auth app:3000 {
      uri /api/auth/me
      copy_headers Cookie
    }
    reverse_proxy app:6080 {
      flush_interval -1
    }
  }

  # Everything else → the dashboard.
  handle {
    reverse_proxy app:3000 {
      # The dashboard's live activity log uses Server-Sent Events.
      # Disable proxy buffering so events stream in real time.
      flush_interval -1
    }
  }
}
