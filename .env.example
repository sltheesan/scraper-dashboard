# MongoDB connection string.
# Production (host-installed Mongo on the VPS):
MONGO_URL=mongodb://root:STRONG_PASSWORD@host.docker.internal:27017/scraper?authSource=admin
# Local development (Atlas free tier OR local Docker Mongo):
# MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scraper?retryWrites=true&w=majority

# Environment: development | production
NODE_ENV=development

# HTTP port for the dashboard
PORT=3000

# Dashboard login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret for signing JWT auth cookies (use a long random string)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Run scrape fetches with a visible browser window?
# true (default) = invisible; false = visible (useful for debugging).
HEADLESS=true

# Which Chromium-family browser to launch.
# 'chrome' (default) = installed Google Chrome (best detection avoidance,
# real Chrome's headless mode is full-featured).
# Set to empty string to use Playwright's bundled chromium.
BROWSER_CHANNEL=chrome

# Telegram bot token from @BotFather (message @BotFather → /newbot).
# Leave blank to disable the bot entirely. Which chat IDs are allowed to
# use the bot is managed in the dashboard → Telegram settings.
TELEGRAM_BOT_TOKEN=
